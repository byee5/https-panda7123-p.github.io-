<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panda7123-p | Official Channel Website</title>
  
  <!-- CSS Styling -->
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #0f0f0f;
      color: #ffffff;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }

    header {
      text-align: center;
      margin-top: 20px;
      margin-bottom: 25px;
    }

    .profile-banner {
      width: 100%;
      max-width: 500px;
      height: 160px;
      object-fit: cover;
      border-radius: 12px;
      margin-bottom: 15px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
    }

    .profile-pic {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      border: 3px solid #ff0000;
      object-fit: cover;
      margin-bottom: 10px;
    }

    header h1 {
      font-size: 2.2rem;
      color: #ff0000;
      margin-bottom: 5px;
    }

    header p {
      color: #aaa;
      font-size: 1rem;
    }

    .card {
      background-color: #212121;
      border-radius: 12px;
      padding: 25px;
      width: 100%;
      max-width: 500px;
      text-align: center;
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.4);
      margin-bottom: 20px;
    }

    .gallery {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 15px;
    }

    .gallery img {
      width: 100%;
      height: 110px;
      object-fit: cover;
      border-radius: 8px;
      transition: transform 0.2s ease;
    }

    .gallery img:hover {
      transform: scale(1.03);
    }

    .btn {
      display: inline-block;
      background-color: #ff0000;
      color: #ffffff;
      text-decoration: none;
      padding: 12px 24px;
      font-size: 1rem;
      font-weight: bold;
      border-radius: 25px;
      border: none;
      cursor: pointer;
      transition: background-color 0.2s ease;
      margin-top: 15px;
    }

    .btn:hover {
      background-color: #cc0000;
    }

    .counter-display {
      font-size: 1.2rem;
      margin-top: 15px;
      color: #ddd;
    }
  </style>
</head>
<body>

  <header>
    <!-- Top Banner Image -->
    <img src="https://via.placeholder.com/600x200/1a1a1a/ffffff?text=Channel+Banner" alt="Channel Banner" class="profile-banner">
    
    <!-- Profile Picture -->
    <img src="https://via.placeholder.com/100/ff0000/ffffff?text=Panda" alt="Panda Profile" class="profile-pic">
    
    <h1>@panda7123-p</h1>
    <p>Welcome to my official YouTube website!</p>
  </header>

  <!-- Channel Link Section -->
  <main class="card">
    <h2>Subscribe to My YouTube Channel</h2>
    <p style="margin-top: 8px; color: #ccc;">Watch my latest videos and tutorials!</p>
    <a href="https://www.youtube.com/@panda7123-p" target="_blank" class="btn">
      Visit Channel
    </a>
  </main>

  <!-- Photo Gallery Section -->
  <section class="card">
    <h2>Featured Highlights</h2>
    <div class="gallery">
      <img src="https://via.placeholder.com/200x120/333333/ffffff?text=Thumbnail+1" alt="Video 1">
      <img src="https://via.placeholder.com/200x120/333333/ffffff?text=Thumbnail+2" alt="Video 2">
      <img src="https://via.placeholder.com/200x120/333333/ffffff?text=Thumbnail+3" alt="Video 3">
      <img src="https://via.placeholder.com/200x120/333333/ffffff?text=Thumbnail+4" alt="Video 4">
    </div>
  </section>

  <!-- Interactive JavaScript Section -->
  <section class="card">
    <h2>Show Your Support</h2>
    <button class="btn" id="likeBtn">❤ Like This Page</button>
    <div class="counter-display" id="likeCount">Likes: 0</div>
  </section>

  <!-- JavaScript Code -->
  <script>
    let likes = 0;
    const likeBtn = document.getElementById('likeBtn');
    const likeCount = document.getElementById('likeCount');

    likeBtn.addEventListener('click', () => {
      likes++;
      likeCount.textContent = `Likes: ${likes}`;
    });
  </script>

